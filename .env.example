# crestron-ha-bridge environment variables. Example values; replace them with your own.
# Copy to `.env` on the docker host (compose loads it) and fill in your
# addresses and MQTT credentials. Never commit the real .env.
# Values above the MQTT section are required — the process exits at startup if
# any are missing. MQTT values are optional; leave MQTT_URL unset for REST-only.

# HTTP listen port
PORT=8022

# Crestron management network details
SSH_HOST=192.168.1.50
SSH_PORT=22
SSH_USERNAME=admin

# Path inside the container to the bind-mounted private key.
# In production this resolves to /app/id_rsa (compose mounts ./id_rsa there).
SSH_PRIVATE_KEY_PATH=id_rsa

# Console command run on each poll and what cadence to run it at.
POLL_COMMAND=DUMPDMROUTEINFO
POLL_INTERVAL_MS=5000

# SSH reconnect attempt cap.
MAX_RETRIES=5

# Per-command SSH timeout.
COMMAND_TIMEOUT_MS=10000

# --- MQTT push to Home Assistant (optional) ---
# In production keep these in .env on the docker host next to id_rsa.
MQTT_URL=mqtt://192.168.1.10:1883
MQTT_USERNAME=changeme
MQTT_PASSWORD=changeme
MQTT_BASE_TOPIC=crestron
HA_DISCOVERY_PREFIX=homeassistant

# JSON maps of number -> label for the HA select entities. Input 0 is "no
# source"; never label it "None" (HA's MQTT select reads that as unknown).
INPUT_NAMES={"0":"Off","1":"Apple TV","2":"Multi","3":"Nintendo Switch","4":"Camera","5":"Apple TV 2","8":"Xbox"}
OUTPUT_NAMES={"101":"Multi 1","102":"Multi 2","103":"Kitchen TV","104":"Spare HDMI","105":"Office TV","106":"Projector"}

# An input with nothing connected. "Off" routes it instead of breaking the
# route (a break leaves video routed on firmware 1.8001) and it's reported as
# Off. Leave unset to send a plain break.
OFF_INPUT=7

# --- Multiviewer (optional, needs MQTT) ---
# ANI-PiP-41UHD behind a USR-TCP232-306 TCP-to-serial bridge. The proxy must
# be the only TCP client on the bridge (it copies replies to every client).
MV_HOST=192.168.1.60
MV_PORT=8234
MV_POLL_INTERVAL_MS=5000
# JSON map of multiviewer HDMI input -> label (window and audio options).
MV_INPUT_NAMES={"1":"Multi 1","2":"Multi 2","3":"Spare HDMI"}
# Which Crestron output feeds each multiviewer HDMI input, for the
# "Window n source" entities (default shown).
MV_HDMI_OUTPUTS={"1":101,"2":102,"3":104}
# Crestron input carrying the multiviewer's own output (never offered as a
# window source).
MV_CRESTRON_INPUT=2

# --- TV (optional, needs MQTT for HA) ---
# ProofVision bathroom TV behind a TCP-to-serial bridge (USR-W610, 115200 8N1).
TV_HOST=192.168.1.61
TV_PORT=8899
# Heartbeat (a no-op key the TV ACKs) cadence; drives entity availability.
TV_POLL_INTERVAL_MS=30000
# HA device name; also sets entity IDs (e.g. switch.bath_tv_power).
TV_NAME=Bath TV
